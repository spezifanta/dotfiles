configuration {
    modi: "drun,window,run";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰀻 Apps";
    display-window: " Windows";
    display-run: " Run";
    drun-display-format: "{name}";
    window-format: "{c}  {t}";
}

// Catppuccin Mocha palette, from https://github.com/catppuccin/rofi
@import "catppuccin-mocha.rasi"

* {
    font: "Hack Nerd Font 12";
    background-color: transparent;
    text-color: @text;
}

window {
    location: center;
    width: 640px;
    padding: 16px;
    border: 2px;
    border-color: @mauve;
    border-radius: 12px;
    background-color: @base;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview, mode-switcher ];
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    border-radius: 8px;
    background-color: @surface0;
    children: [ prompt, entry ];
}

prompt {
    text-color: @mauve;
}

entry {
    placeholder: "Search…";
    placeholder-color: @overlay0;
    cursor: text;
}

listview {
    lines: 8;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @text; }
element normal.active, element alternate.active { background-color: transparent; text-color: @blue; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @red; }
element selected.normal { background-color: @mauve; text-color: @crust; }
element selected.active { background-color: @blue; text-color: @crust; }
element selected.urgent { background-color: @red; text-color: @crust; }

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding: 6px;
    border-radius: 8px;
    background-color: @surface0;
    text-color: @subtext0;
    cursor: pointer;
}

button selected {
    background-color: @mauve;
    text-color: @crust;
}
