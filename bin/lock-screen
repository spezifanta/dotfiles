#!/bin/bash
#
# Catppuccin Mocha lock screen (needs i3lock-color).
# Blurs the current screen, shows a clock and a ring that reacts to typing.
# Extra arguments are passed on, e.g. --nofork from xss-lock.

base=1e1e2ecc
text=cdd6f4ff
subtext=a6adc8ff
mauve=cba6f7ff
lavender=b4befeff
green=a6e3a1ff
red=f38ba8ff
clear=00000000
font="Hack Nerd Font"

i3lock \
    --blur 8 \
    --clock --indicator \
    --radius 110 --ring-width 8 \
    --time-str "%H:%M" --date-str "%A, %d %B" \
    --time-font "$font" --date-font "$font" --verif-font "$font" --wrong-font "$font" --layout-font "$font" \
    --time-size 72 --date-size 22 --verif-size 18 --wrong-size 18 \
    --time-pos "ix:iy-230" --date-pos "tx:ty+45" \
    --time-color $text --date-color $subtext \
    --inside-color $base --ring-color $mauve --line-uses-inside --separator-color $clear \
    --keyhl-color $lavender --bshl-color $red \
    --insidever-color $base --ringver-color $green --verif-color $green \
    --insidewrong-color $base --ringwrong-color $red --wrong-color $red \
    --verif-text "checking…" --wrong-text "wrong" --noinput-text "empty" --lock-text "locking…" \
    --pass-media-keys --pass-volume-keys \
    "$@"
