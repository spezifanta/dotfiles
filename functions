# List the contents every time we change directories.
function cd {
    builtin cd "$@" && ls --group-directories-first
}

# Create a new directory and change into it.
function mkd {
    mkdir -p "$1" && cd "$1"
}

# Grep a process by given name.
function psgrep {
    ps aux | grep -E "^USER|$1" | grep -v "grep -E" --color=always
}

# Pretty print JSON output.
# Usage: echo '{"foobar": 42}' | json
function json {
    python -m json.tool
}

function afk {
    i3lock --color=000000
}

# Because I commit 100% from console.
# Usage: gcm This is a commit msg
function gcm {
    git commit -m "$*"
}
